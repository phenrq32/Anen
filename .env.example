# Copiar para apps/web/.env.local e preencher. Nunca versionar o ficheiro preenchido.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...) ou anon key legada. É pública por natureza; a proteção vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública da aplicação (usada nos links de e-mail e redirecionamentos OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login Google: só ativar depois de configurar o provider no Supabase (Authentication > Providers > Google)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# A chave service_role NUNCA vai para o frontend nem para variáveis NEXT_PUBLIC_*.
# Só será usada em Edge Functions / jobs de servidor nas fases seguintes.
# SUPABASE_SERVICE_ROLE_KEY=

# ANEN AI (Google Gemini). Sem chave, a página da IA diz que não está ativada.
GEMINI_API_KEY=
# Opcional: modelos por ordem de preferência, separados por vírgula.
GEMINI_MODELS=

# Faturação (InvoiceXpress): chave mestra de 32 bytes em base64 para cifrar as chaves da API dos clientes.
INVOICING_ENCRYPTION_KEY=
